{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "@playwright/test"],
    "paths": {
      "@pages/*": ["./pages/*"],
      "@fixtures/*": ["./fixtures/*"],
      "@utils/*": ["./utils/*"],
      "@hooks/*": ["./hooks/*"],
      "@api/*": ["./api/*"]
    }
  },
  "include": ["tests/**/*.ts",
   "pages/**/*.ts",
   "fixtures/**/*.ts",
    "utils/**/*.ts",
    "hooks/**/*.ts",
    "api/**/*.ts",
    "playwright.config.ts"]
}

